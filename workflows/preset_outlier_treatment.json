{
  "workflow_id": "preset_outlier_treatment",
  "name": "\ud83c\udfaf Statistical Outlier Suppression (IQR)",
  "description": "Identifies extreme numerical values using IQR and caps them to 1.5x boundaries.",
  "version": "1.0.0",
  "created_at": "2026-11-04 14:54:27",
  "updated_at": "2026-11-04 14:54:27",
  "tags": [
    "statistics",
    "outliers",
    "data_quality"
  ],
  "steps": [
    {
      "step_id": "step_p4_1",
      "name": "Clean Numeric Column",
      "category": "data_cleaning",
      "operation": "clean_numeric_formatting",
      "params": {
        "columns": [
          "Amount"
        ],
        "strip_symbols": true
      },
      "enabled": true
    },
    {
      "step_id": "step_p4_2",
      "name": "Cap Extreme Values via IQR 1.5x",
      "category": "data_cleaning",
      "operation": "treat_outliers",
      "params": {
        "column": "Amount",
        "method": "iqr",
        "action": "cap",
        "multiplier": 1.5
      },
      "enabled": true
    },
    {
      "step_id": "step_p4_3",
      "name": "Sort by Cleaned Amount Descending",
      "category": "row_ops",
      "operation": "sort_records",
      "params": {
        "sort_cols": [
          "Amount"
        ],
        "ascending_list": [
          false
        ]
      },
      "enabled": true
    }
  ]
}